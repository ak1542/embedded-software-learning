      "title": "Start here",
      "blocks": [
        {
          "id": "b-seed001",
          "type": "callout",
          "data": {
            "variant": "tip",
            "title": "How this site works",
            "md": "Click **Edit** (top right) to add, change, reorder or delete notes, sections and subsections. Press **Save** (or Ctrl+S) to store them in GitHub. Open **⚙ Settings** once on each device to connect GitHub."
          }
        },
        {
          "id": "b-seed002",
          "type": "text",
          "data": {
            "md": "Each page is built from **blocks**. In edit mode, use **+ Add block** to insert:\n\n- **Text**: Markdown with lists, tables, links and `inline code`. Paste or drop an image straight in.\n- **Heading**, **Callout**, **Divider**\n- **Code**: highlighted C, C++, ARM assembly, Python, Rust and more, with a copy button\n- **Image** and **Animation / video**: GIF, MP4 or WebM, uploaded to the repository\n- **Step-by-step animation**: frames that play in order\n- **Diagram**: flowcharts, state machines and sequence diagrams from text\n- **Embed**: YouTube videos or a Wokwi simulation"
          }
        },
        {
          "id": "b-seed003",
          "type": "heading",
          "data": {
            "text": "Example: step-by-step animation",
            "level": 3
          }
        },
        {
          "id": "b-seed004",
          "type": "steps",
          "data": {
            "intervalMs": 2200,
            "autoplay": true,
            "frames": [
              {
                "src": "",
                "caption": "UART line idles HIGH"
              },
              {
                "src": "",
                "caption": "Start bit: line pulled LOW for one bit time"
              },
              {
                "src": "",
                "caption": "Data bits: usually 8, least significant bit first"
              },
              {
                "src": "",
                "caption": "Optional parity bit"
              },
              {
                "src": "",
                "caption": "Stop bit: line returns HIGH"
              }
            ]
          }
        },
        {
          "id": "b-seed005",
          "type": "heading",
          "data": {
            "text": "Example: diagram",
            "level": 3
          }
        },
        {
          "id": "b-seed006",
          "type": "diagram",
          "data": {
            "code": "stateDiagram-v2\n    [*] --> Ready\n    Ready --> Running: scheduled\n    Running --> Ready: preempted\n    Running --> Blocked: waits for event\n    Blocked --> Ready: event arrives",
            "caption": "RTOS task states"
          }
        }
      ],
