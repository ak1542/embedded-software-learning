          "id": "s-seed012",
          "title": "The volatile keyword",
          "blocks": [
            {
              "id": "b-seed011",
              "type": "callout",
              "data": {
                "variant": "warning",
                "title": "Rule of thumb",
                "md": "Use `volatile` for memory-mapped hardware registers and for variables shared between an ISR and the main loop. It stops the compiler from caching the value, but it does **not** make access atomic."
              }
            }
          ],
