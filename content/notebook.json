    {
      "id": "s-seed014",
      "title": "C for embedded",
      "blocks": [
        {
          "id": "b-seed008",
          "type": "text",
          "data": {
            "md": "The parts of C that matter most on microcontrollers."
          }
        }
      ],
      "children": [
        {
          "id": "s-seed010",
          "title": "Bit manipulation",
          "blocks": [
            {
              "id": "b-seed009",
              "type": "code",
              "data": {
                "lang": "c",
                "filename": "bits.h",
                "code": "#define BIT(n)            (1UL << (n))\n#define SET_BIT(reg, n)   ((reg) |=  BIT(n))\n#define CLEAR_BIT(reg, n) ((reg) &= ~BIT(n))\n#define TOGGLE_BIT(reg, n) ((reg) ^= BIT(n))\n#define READ_BIT(reg, n)  (((reg) >> (n)) & 1UL)",
                "caption": "Set, clear, toggle and read single bits"
              }
            }
          ],
          "children": []
        },
        {
          "id": "s-seed012",
          "title": "The volatile keyword",
          "blocks": [
            {
              "id": "b-seed011",
              "type": "callout",
              "data": {
                "variant": "warning",
                "title": "Rule of thumb",
                "md": "Use `volatile` for memory-mapped hardware registers and for variables shared between an ISR and the main loop. It stops the compiler from caching the value, but it does **not** make access atomic."
              }
            }
          ],
          "children": []
        },
